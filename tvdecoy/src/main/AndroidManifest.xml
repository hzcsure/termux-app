<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅 BOOT_COMPLETED 需要此权限；SCREEN_ON / USER_PRESENT 不需要 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 方案 B：悬浮窗诱饵（DecoyService）所需。
         需先 adb shell appops set com.hzc.tvdecoy SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.DecoyTransparent">

        <!--
            透明栈顶 Activity（前台诱饵）：
            - 2026-09-16 实测：小米 PMS 的 "current" 按【栈顶 resumed Activity】判定，
              与可见窗口 / overlay 无关（TYPE_APPLICATION_OVERLAY 悬浮窗已实测否决）。
              所以必须由 Activity 占位，悬浮窗挡不住 kill。
            - 必须保持独立包名 com.hzc.tvdecoy：PMS 的落点是
              forceStopPackage package:<pkg>，按包名杀。若与 TVHome 同包名则两者
              同 UID 同 cgroup 一起死，保护在数学上无效。
            - 2026-09-16 改：去掉 singleInstance + 独立 taskAffinity。
              这两项会让本 Activity 另起 task，导致下方 TVHome 被 stop
              （mDrawState=NO_SURFACE）而无法获得焦点 → mCurrentFocus=null → ANR。
              去掉后由 TVHome 用 startActivity（不带 NEW_TASK）拉起，
              本 Activity 落入 TVHome 自己的 task，TVHome 仅 pause 且窗口保留，
              焦点得以穿透到 TVHome。
        -->
        <activity
            android:name=".DecoyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.DecoyTransparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 方案 B：悬浮窗诱饵。不启动任何 Activity，只对屏幕挂一个
             NOT_FOCUSABLE + NOT_TOUCHABLE 的 1x1 透明 overlay，
             理论上完全不影响 TVHome 的输入。用于验证「current 前台应用」
             到底按 Activity 栈顶还是按可见窗口判定。 -->
        <service
            android:name=".DecoyService"
            android:exported="true" />

        <!-- 开机 / 解锁 / 亮屏 时自启，把诱饵重新顶到前台 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.SCREEN_ON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
